# =============================================================================
# Databricks credentials for Zerobus SDK integration tests
# =============================================================================
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Required by the Java and TypeScript integration test suites only —
# Rust, Python, and Go tests are mock-based and need nothing.
#
# .scripts/run.sh checks for `.env` at the repo root:
#   - present  → tests run inside the build containers (RUN_TESTS=1)
#   - missing  → tests are skipped, build + lint still run (RUN_TESTS=0)
#
# Where to find these values:
#   - DATABRICKS_WORKSPACE_URL: your workspace browser URL (before "/o=")
#   - ZEROBUS_SERVER_ENDPOINT: derived from your workspace region. The
#     hostname suffix follows the workspace cloud:
#       AWS:   <workspace-id>.zerobus.<region>.cloud.databricks.com
#       Azure: <workspace-id>.zerobus.<region>.azuredatabricks.net
#     Ask your Databricks admin if unsure.
#   - DATABRICKS_CLIENT_ID / SECRET: a service principal you've granted
#     USE_CATALOG / USE_SCHEMA / SELECT, MODIFY on the test table
#   - ZEROBUS_TABLE_NAME: fully-qualified Delta table (catalog.schema.table)
#     that the integration tests are allowed to write to
# =============================================================================

# AWS form:
ZEROBUS_SERVER_ENDPOINT="https://<workspace-id>.zerobus.<region>.cloud.databricks.com"
# Azure form:
# ZEROBUS_SERVER_ENDPOINT="https://<workspace-id>.zerobus.<region>.azuredatabricks.net"

DATABRICKS_WORKSPACE_URL="https://<workspace>.cloud.databricks.com"
ZEROBUS_TABLE_NAME="catalog.schema.table"

DATABRICKS_CLIENT_ID="<service-principal-application-id>"
DATABRICKS_CLIENT_SECRET="<service-principal-secret>"
